{}
[(Observe Observation)
 (Validate Validation)]
[(Observed ObservationResult)
 (Validated ValidationReport)
 (RequestUnsupported UnsupportedRequest)
 (RequestRejected RejectedRequest)]
{
  Observe Observation
  Validate Validation
  Observed ObservationResult
  Validated ValidationReport
  RequestUnsupported UnsupportedRequest
  RequestRejected RejectedRequest

  DomainName String
  RecordValue String
  UniformResourceLocator String
  PlanIdentifier String
  ProviderAccount String
  ZoneIdentifier String
  RuleIdentifier String
  HostIdentifier String
  ServerType String
  ImageName String
  IpAddress String
  Provider [Cloudflare GoogleCloud Hetzner]
  Capability [DomainNameSystemRecords RedirectRules CloudHosts Networks Firewalls LoadBalancers]
  CapabilityState [NotBuilt Compiled Configured Authorized Unsupported Unauthorized]
  RecordKind [AddressV4 AddressV6 CanonicalName Text MailExchange NameServer Pointer Service CertificateAuthorityAuthorization SecureShellFingerprint TransportLayerSecurityAuthentication UniformResourceIdentifier ServiceBinding HttpsBinding Location]
  ProxyMode [Direct ProviderProxy]
  RedirectStatus [Permanent Temporary]
  PathTreatment [Preserve Replace]
  HostStatus [Initializing Running Stopped Deleting Unknown]

  CapabilityQuery { provider (Optional Provider) capability (Optional Capability) }
  CapabilityObservation { provider Provider capability Capability capability_state CapabilityState }
  CapabilityReport { capabilities (Vector CapabilityObservation) }
  ZoneQuery { provider (Optional Provider) account (Optional ProviderAccount) }
  Zone { provider Provider provider_account ProviderAccount zone_identifier ZoneIdentifier domain_name DomainName }
  ZoneListing { zones (Vector Zone) }
  HostQuery { provider Provider provider_account (Optional ProviderAccount) }
  CloudHost { provider Provider provider_account ProviderAccount host_identifier HostIdentifier host_name DomainName server_type ServerType image_name ImageName ipv4_address IpAddress host_status HostStatus }
  CloudHostListing { hosts (Vector CloudHost) }
  DomainNameSystemRecord { domain_name DomainName record_kind RecordKind record_value RecordValue proxy_mode ProxyMode }
  RecordQuery { provider Provider domain_name DomainName }
  RecordListing { records (Vector DomainNameSystemRecord) }
  RedirectRule { domain_name DomainName uniform_resource_locator UniformResourceLocator redirect_status RedirectStatus path_treatment PathTreatment }
  RedirectQuery { provider Provider domain_name DomainName }
  RedirectListing { rules (Vector RedirectRule) }
  DesiredState { provider Provider domain_name DomainName records (Vector DomainNameSystemRecord) redirects (Vector RedirectRule) }
  Validation DesiredState
  Plan { plan_identifier PlanIdentifier provider Provider domain_name DomainName records_to_create (Vector DomainNameSystemRecord) records_to_update (Vector DomainNameSystemRecord) record_names_to_delete (Vector DomainName) redirects_to_create (Vector RedirectRule) redirects_to_update (Vector RedirectRule) redirect_sources_to_delete (Vector DomainName) }
  PlanQuery PlanIdentifier
  Observation [(Capabilities Capabilities) (Zones Zones) (Records Records) (Redirects Redirects) (ObserveServers ObserveServers) (ObservePlan ObservePlan)]
  Capabilities CapabilityQuery
  Zones ZoneQuery
  Records RecordQuery
  Redirects RedirectQuery
  ObserveServers HostQuery
  ObservePlan PlanQuery
  ObservationResult [(Capabilities CapabilityReport) (Zones ZoneListing) (Records RecordListing) (Redirects RedirectListing) (Servers CloudHostListing) (PlanResult PlanResult)]
  PlanResult Plan
  FindingSeverity [Notice Warning Error]
  ValidationFinding { finding_severity FindingSeverity message Message }
  Message String
  ValidationReport { findings (Vector ValidationFinding) }
  UnsupportedReason [ProviderNotBuilt ProviderNotCompiled ProviderNotConfigured CapabilityNotCompiled CapabilityNotConfigured CapabilityUnauthorized]
  UnsupportedRequest { provider (Optional Provider) capability (Optional Capability) reason UnsupportedReason }
  RejectionReason [InvalidDesiredState PlanExpired ProviderRateLimited ProviderUnavailable]
  RejectedRequest RejectionReason
}
